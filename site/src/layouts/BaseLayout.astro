---
import type { FooterGroupId, SitePage } from "../config/site-manifest";
import type { CollectionEntry } from "astro:content";
import SeoHead from "../components/seo/SeoHead.astro";
import Footer from "../components/site/Footer.astro";
import Header from "../components/site/Header.astro";
import bolusFavicon from "../assets/logos/bolus-favicon.png";
import "../styles/global.css";

interface Props {
  page: SitePage; // Still used for header/labels
  seo: CollectionEntry<"pages">["data"]; // Enforcement of TSOP metadata
  showChrome?: boolean;
  showHeader?: boolean;
  showFooter?: boolean;
  footerOmitGroups?: FooterGroupId[];
  footerVariant?: "default" | "dark";
  mainClass?: string;
  assetHints?: AssetHint[];
}

interface AssetHint {
  href: string;
  as?: "image" | "video";
  rel?: "preload" | "prefetch";
  type?: string;
  fetchpriority?: "high" | "low" | "auto";
}

const {
  page,
  seo,
  showChrome = true,
  showHeader = showChrome,
  showFooter = showChrome,
  footerOmitGroups = [],
  footerVariant = "default",
  mainClass = "site-main",
} = Astro.props;
const assetHints = Astro.props.assetHints ?? [];
---

<!doctype html>
<html lang="en" data-font-mode="apple">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={bolusFavicon.src} />
    {assetHints.map((hint) => (
      <link
        rel={hint.rel ?? "preload"}
        href={hint.href}
        as={hint.rel === "prefetch" ? undefined : hint.as}
        type={hint.type}
        fetchpriority={hint.fetchpriority}
      />
    ))}
    <SeoHead data={seo} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="ipad-debug-badge">TABLET PORTRAIT ACTIVE</div>
    <div class="site-build-badge">SITE BUILD ACTIVE</div>
    <div class="viewport-debug">
      WIDTH: <span id="vw-display">0</span>px<br/>
      ORIENT: <span id="orient-display">unknown</span>
    </div>

    <script is:inline>
      function updateDebug() {
        const vw = document.getElementById('vw-display');
        const orient = document.getElementById('orient-display');
        if (vw) vw.textContent = window.innerWidth;
        if (orient) orient.textContent = window.innerHeight > window.innerWidth ? 'PORTRAIT' : 'LANDSCAPE';
      }
      window.addEventListener('resize', updateDebug);
      updateDebug();
    </script>

    {showHeader && <Header currentPath={page.path} />}
    <main id="content" class={mainClass}>
      <article itemscope itemtype="https://schema.org/Article">
        <slot />
      </article>
    </main>
    {showFooter && <Footer omitGroups={footerOmitGroups} variant={footerVariant} />}
  </body>
</html>
