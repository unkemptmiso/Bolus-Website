---
import { getEntry } from "astro:content";
import { appStoreListingUrl, getPageById } from "../config/site-manifest";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = getPageById("mobile-anesthesia-charting");
const seo = await getEntry("pages", "mobile-anesthesia-charting");
if (!page) throw new Error("Could not find the 'mobile-anesthesia-charting' page config.");
if (!seo) throw new Error("Could not find the 'mobile-anesthesia-charting' page metadata.");

const solutionCards = [
  {
    title: "Chart on the devices you already carry.",
    body: "Bolus is built for mobile anesthesia charting on iPhone and iPad, so documentation can stay with the clinician instead of living on a clipboard or desktop workstation.",
    iconSrc: "/section3-icons/hourglass-not-done_23f3.png",
  },
  {
    title: "Keep the case connected.",
    body: "Pre-Op, Intra-Op, and Post-Op stay in one anesthesia record, reducing the need to stitch separate forms together after the procedure.",
    iconSrc: "/section3-icons/1f5c2_1f2qe.webp",
  },
  {
    title: "Leave with a clean PDF.",
    body: "When the case is complete, Bolus exports a legible, organized anesthesia record PDF that looks professional when reviewed, shared, or stored.",
    iconSrc: "/section3-icons/1f4e4_1knv5.webp",
  },
] as const;

const workflowPhases = [
  {
    label: "Pre-Op",
    title: "Pre-op without the paper shuffle.",
    body: "Document evaluation notes, consent, attachments, and case details before the procedure starts.",
  },
  {
    label: "Intra-Op",
    title: "Chart vitals, medications, and events in the room.",
    body: "Record the timeline as the case moves, without manually rebuilding the story later from memory and handwritten notes.",
  },
  {
    label: "Post-Op",
    title: "Wrap the record cleanly.",
    body: "Complete recovery documentation, discharge vitals, controlled substance reconciliation, and final review in the same workflow.",
  },
] as const;

const comparisonPoints = [
  {
    title: "Focused charting",
    body: "Bolus concentrates on the anesthesia record itself: fast charting, clear timelines, and a polished final PDF.",
  },
  {
    title: "Mobile-first workflow",
    body: "The page is built around iPhone and iPad charting because mobile and office-based anesthesia often happens away from a fixed documentation station.",
  },
  {
    title: "Less administrative noise",
    body: "Many mobile anesthesia practice software platforms center scheduling, billing, portals, and broad practice operations. Bolus keeps the story closer to clinical documentation.",
  },
] as const;

const audienceTypes = [
  "Mobile anesthesiologists",
  "CRNAs",
  "Dentist anesthesiologists",
  "Oral surgery offices",
  "Dental sedation teams",
  "Office-based procedural sedation",
] as const;

const exportPages = [
  { src: "/assets/record-screenshots/page-1.webp", label: "Bolus PDF anesthesia record page 1" },
  { src: "/assets/record-screenshots/page-2.webp", label: "Bolus PDF anesthesia record page 2" },
  { src: "/assets/record-screenshots/page-3.webp", label: "Bolus PDF anesthesia record page 3" },
] as const;

const securityPoints = [
  "AES-256 encryption",
  "Authentication-gated access",
  "PHI stored locally on device",
] as const;

const faqs = [
  {
    question: "What should a mobile anesthesia charting app include?",
    answer:
      "A useful mobile anesthesia charting app should support the full case record: pre-op evaluation, consent and attachments, intra-op vitals, medications, fluids, events, recovery notes, and a clean anesthesia record PDF export.",
  },
  {
    question: "Can Bolus work for mobile anesthesia practices?",
    answer:
      "Yes. Bolus is designed for mobile anesthesia practices and office-based anesthesia teams that need charting on iPhone and iPad instead of relying on paper forms or a desktop-bound EMR.",
  },
  {
    question: "How is Bolus different from mobile anesthesia practice software?",
    answer:
      "Bolus is focused on anesthesia documentation rather than trying to become a full practice management platform. If you are comparing mobile anesthesia practice software, Maps Anesthesia, broad EMR tools, or paper charting, Bolus is the more focused record-first option.",
  },
  {
    question: "Can Bolus replace paper anesthesia charts?",
    answer:
      "Bolus is built to replace paper anesthesia charting with a cleaner digital workflow. Clinicians can document the case in the app and finish with a legible, organized PDF record.",
  },
  {
    question: "Does Bolus support iPhone and iPad anesthesia charting?",
    answer:
      "Yes. Bolus is built around iPhone and iPad anesthesia charting so providers can document where the case is happening, not only from a fixed office computer.",
  },
  {
    question: "Is Bolus for hospital anesthesia departments?",
    answer:
      "Bolus is primarily positioned for office-based, outpatient, dental, oral surgery, and mobile anesthesia workflows where paper charting is still common and a large hospital system may be the wrong fit.",
  },
] as const;
---

<BaseLayout page={page} seo={seo.data} mainClass="site-main site-main--mobile-charting">
  <section class="mc-hero" aria-labelledby="mc-hero-title">
    <div class="mc-hero__inner">
      <div class="mc-hero__copy">
        <p class="mc-eyebrow">Mobile Anesthesia Charting App</p>
        <h1 id="mc-hero-title" class="mc-hero__title">Mobile anesthesia charting for office-based cases.</h1>
        <p class="mc-hero__lede">
          Bolus helps mobile and office-based anesthesia providers chart on iPhone and iPad,
          keep the case connected from pre-op through recovery, and export a clean PDF record
          when the procedure is done.
        </p>
        <div class="mc-actions" aria-label="Mobile anesthesia charting page actions">
          <a
            class="mc-button mc-button--primary"
            href={appStoreListingUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Get the app
          </a>
          <a class="mc-button mc-button--secondary" href="#workflow">See the workflow</a>
        </div>
      </div>

      <figure class="mc-hero__media">
        <img
          src="/combined-hero-shot.png"
          alt="The Bolus mobile anesthesia charting interface shown on iPhone and iPad"
          width="2560"
          height="1500"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="mc-problem" aria-labelledby="mc-problem-title">
    <div class="mc-problem__inner">
      <div class="mc-problem__copy">
        <p class="mc-eyebrow mc-eyebrow--dark">Why mobile charting matters</p>
        <h2 id="mc-problem-title">Paper gets worse when the practice is mobile.</h2>
        <p>
          Mobile anesthesia cases do not always have a hospital EMR, an anesthesia cart, or a
          fixed documentation station. The record has to move with the clinician, stay legible
          during the case, and still make sense when someone reviews it later.
        </p>
      </div>

      <figure class="mc-problem__record">
        <img
          src="/assets/home/updated-anesthesia-record.webp"
          alt="Handwritten paper anesthesia record with crossed-out notes and vitals"
          width="980"
          height="1305"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="mc-solution" aria-labelledby="mc-solution-title">
    <div class="mc-section-heading mc-section-heading--centered">
      <p class="mc-eyebrow">Paperless anesthesia charting</p>
      <h2 id="mc-solution-title">A mobile record that keeps up in the room.</h2>
      <p>
        Bolus turns mobile anesthesia documentation into a cleaner workflow: chart quickly while
        care is happening, then leave with a record that is easier to read and easier to stand
        behind.
      </p>
    </div>

    <div class="mc-solution__stack" role="list" aria-label="Bolus mobile charting benefits">
      {solutionCards.map((card) => (
        <article class="mc-solution-card" role="listitem">
          <img src={card.iconSrc} alt="" width="44" height="44" loading="lazy" decoding="async" aria-hidden="true" />
          <div>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="workflow" class="mc-workflow" aria-labelledby="mc-workflow-title">
    <div class="mc-workflow__inner">
      <div class="mc-workflow__copy">
        <p class="mc-eyebrow">Pre-Op to Post-Op</p>
        <h2 id="mc-workflow-title">Built for the way mobile anesthesia actually moves.</h2>
        <p>
          The strongest mobile anesthesia charting workflow is not a pile of screens. It is one
          connected record that follows the case from the first note to the final export.
        </p>

        <div class="mc-workflow__phases" role="list">
          {workflowPhases.map((phase) => (
            <article class="mc-phase" role="listitem">
              <p>{phase.label}</p>
              <h3>{phase.title}</h3>
              <span>{phase.body}</span>
            </article>
          ))}
        </div>
      </div>

      <div class="mc-workflow__phone" aria-label="Bolus intra-op vitals workflow preview">
        <img
          class="mc-workflow__frame"
          src="/assets/iphone-17-black-portrait.webp"
          alt=""
          width="900"
          height="1800"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
        <video
          class="mc-workflow__video"
          src="/assets/workflow/intra-op-vitals.mp4"
          muted
          autoplay
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        ></video>
      </div>
    </div>
  </section>

  <section class="mc-focus" aria-labelledby="mc-focus-title">
    <div class="mc-focus__inner">
      <div class="mc-section-heading">
        <p class="mc-eyebrow">Alternative landing page positioning</p>
        <h2 id="mc-focus-title">Focused charting, not another bloated practice platform.</h2>
        <p>
          Search results for mobile anesthesia practice can make every product sound like an
          all-in-one operations suite. Bolus is intentionally narrower: the anesthesia record,
          the mobile charting workflow, and the final PDF.
        </p>
      </div>

      <div class="mc-focus__grid" role="list">
        {comparisonPoints.map((point) => (
          <article class="mc-focus-card" role="listitem">
            <h3>{point.title}</h3>
            <p>{point.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mc-audience" aria-labelledby="mc-audience-title">
    <div class="mc-audience__inner">
      <h2 id="mc-audience-title">Made for anesthesia outside the hospital OR.</h2>
      <div class="mc-audience__pills" aria-label="Provider types">
        {audienceTypes.map((type) => <span>{type}</span>)}
      </div>
    </div>
  </section>

  <section class="mc-export" aria-labelledby="mc-export-title">
    <div class="mc-section-heading mc-section-heading--centered">
      <p class="mc-eyebrow">Anesthesia Record PDF Export</p>
      <h2 id="mc-export-title">A finished record that does not look like a scanned worksheet.</h2>
      <p>
        The final anesthesia record is one of the best reasons to leave paper. Bolus organizes
        medications, vital signs, events, and recovery details into a PDF that is cleaner to
        review, store, and share.
      </p>
    </div>

    <div class="mc-export__pages" aria-label="Bolus anesthesia record PDF previews">
      {exportPages.map((page, index) => (
        <figure class="mc-export-page" style={`--page-index:${index};`}>
          <img src={page.src} alt={page.label} width="2479" height="3508" loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  </section>

  <section class="mc-security" aria-labelledby="mc-security-title">
    <div class="mc-security__inner">
      <img src="/privacy-lock.svg" alt="" width="64" height="64" loading="lazy" decoding="async" aria-hidden="true" />
      <h2 id="mc-security-title">Secure by design.</h2>
      <p>
        Bolus is built for secure anesthesia documentation, using AES-256 encryption,
        authentication-gated access, and local on-device storage so PHI stays controlled.
      </p>
      <div class="mc-security__points" aria-label="Security proof points">
        {securityPoints.map((point) => <span>{point}</span>)}
      </div>
    </div>
  </section>

  <section class="mc-faq" data-mc-faq-section aria-labelledby="mc-faq-title">
    <div class="mc-faq__inner">
      <div class="mc-section-heading">
        <p class="mc-eyebrow">Mobile anesthesia charting FAQ</p>
        <h2 id="mc-faq-title">Questions clinicians search before switching.</h2>
      </div>

      <div class="mc-faq__list">
        {faqs.map((faq) => (
          <article class="mc-faq__item" data-mc-faq-item>
            <button class="mc-faq__trigger" type="button" data-mc-faq-trigger aria-expanded="false">
              <span>{faq.question}</span>
              <span class="mc-faq__icon" aria-hidden="true"></span>
            </button>
            <div class="mc-faq__content">
              <div class="mc-faq__content-inner">
                <p>{faq.answer}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mc-close" aria-labelledby="mc-close-title">
    <div class="mc-close__inner">
      <div class="mc-close__copy">
        <p class="mc-eyebrow">Leave paper behind</p>
        <h2 id="mc-close-title">Bring mobile anesthesia charting up to the standard of your care.</h2>
        <p>
          Bolus gives office-based and mobile anesthesia providers a cleaner way to document the
          case, protect the record, and finish with a professional PDF.
        </p>
        <div class="mc-actions">
          <a
            class="mc-button mc-button--primary"
            href={appStoreListingUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Get the app
          </a>
          <a class="mc-button mc-button--secondary" href="/pricing">View pricing</a>
        </div>
      </div>
      <img
        src="/assets/home/download-devices.webp"
        alt="The Bolus app interface shown across iPhone, iPad mini, and iPad Pro"
        width="1689"
        height="1082"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const section = document.querySelector("[data-mc-faq-section]");
    if (!(section instanceof HTMLElement)) return;

    const items = Array.from(section.querySelectorAll("[data-mc-faq-item]"));
    const setOpenItem = (openIndex) => {
      items.forEach((item, index) => {
        const trigger = item.querySelector("[data-mc-faq-trigger]");
        const content = item.querySelector(".mc-faq__content");
        if (!(trigger instanceof HTMLButtonElement) || !(content instanceof HTMLElement)) return;

        const isOpen = index === openIndex;
        item.classList.toggle("is-open", isOpen);
        trigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
        content.classList.toggle("is-open", isOpen);
      });
    };

    items.forEach((item, index) => {
      const trigger = item.querySelector("[data-mc-faq-trigger]");
      if (!(trigger instanceof HTMLButtonElement)) return;

      trigger.addEventListener("click", () => {
        const isExpanded = trigger.getAttribute("aria-expanded") === "true";
        setOpenItem(isExpanded ? -1 : index);
      });
    });
  })();
</script>

<style>
  .mc-eyebrow {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #007aff;
  }

  .mc-eyebrow--dark {
    color: rgba(126, 180, 255, 0.94);
  }

  .mc-button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding: 0 1.25rem;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .mc-button:hover,
  .mc-button:focus-visible {
    transform: translateY(-1px);
  }

  .mc-button--primary {
    background: #007aff;
    color: #ffffff;
    box-shadow: 0 16px 34px rgba(0, 122, 255, 0.2);
  }

  .mc-button--secondary {
    border: 1px solid rgba(15, 23, 42, 0.12);
    background: rgba(255, 255, 255, 0.82);
    color: rgba(15, 23, 42, 0.82);
  }

  .mc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .mc-section-heading {
    display: grid;
    gap: 1rem;
    max-width: 47rem;
  }

  .mc-section-heading--centered {
    margin: 0 auto;
    justify-items: center;
    text-align: center;
  }

  .mc-section-heading h2,
  .mc-problem h2,
  .mc-audience h2,
  .mc-security h2,
  .mc-close h2 {
    margin: 0;
    font-size: clamp(2.8rem, 5vw, 4.1rem);
    line-height: 1;
    letter-spacing: -0.28px;
    font-weight: 700;
    color: #000000;
  }

  .mc-section-heading p:not(.mc-eyebrow),
  .mc-problem p:not(.mc-eyebrow),
  .mc-security p,
  .mc-close p:not(.mc-eyebrow) {
    margin: 0;
    font-size: 21px;
    line-height: 1.5;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.65);
  }

  .mc-hero {
    overflow: clip;
    background: #ffffff;
  }

  .mc-hero__inner {
    width: min(1380px, calc(100vw - 2.5rem));
    margin: 0 auto;
    padding: clamp(3.25rem, 6vw, 5.5rem) 0 clamp(2.25rem, 5vw, 4rem);
    display: grid;
    gap: clamp(2rem, 4vw, 3.25rem);
    justify-items: center;
    text-align: center;
  }

  .mc-hero__copy {
    display: grid;
    gap: 1rem;
    justify-items: center;
    max-width: 58rem;
  }

  .mc-hero__title {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(4rem, 6.2vw, 6.25rem);
    line-height: 1;
    letter-spacing: -1px;
    font-weight: 700;
    color: #000000;
  }

  .mc-hero__lede {
    max-width: 48rem;
    margin: 0;
    font-size: 21px;
    line-height: 1.5;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.65);
  }

  .mc-hero__media {
    width: 100%;
    margin: 0;
  }

  .mc-hero__media img {
    display: block;
    width: min(100%, 1280px);
    height: auto;
    margin: 0 auto;
    filter:
      drop-shadow(0 12px 28px rgba(15, 23, 42, 0.14))
      drop-shadow(0 4px 10px rgba(15, 23, 42, 0.08));
  }

  .mc-problem {
    position: relative;
    overflow: clip;
    background:
      radial-gradient(circle at top center, rgba(54, 67, 122, 0.16), transparent 36%),
      linear-gradient(180deg, #07030c 0%, #040109 100%);
  }

  .mc-problem__inner {
    position: relative;
    width: min(1120px, calc(100vw - 2.5rem));
    min-height: clamp(560px, 70vw, 760px);
    margin: 0 auto;
    padding: clamp(5.75rem, 10vw, 8.5rem) 0 clamp(6rem, 10vw, 8.75rem);
    isolation: isolate;
  }

  .mc-problem__copy {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.55rem;
    max-width: 42rem;
  }

  .mc-problem h2 {
    max-width: 14ch;
    color: #ffffff;
  }

  .mc-problem p:not(.mc-eyebrow) {
    max-width: 48ch;
    color: rgba(255, 255, 255, 0.78);
  }

  .mc-problem__record {
    position: absolute;
    right: clamp(-18rem, -16vw, -10rem);
    bottom: clamp(-4.25rem, -6vw, -2rem);
    z-index: 1;
    width: min(48vw, 580px);
    margin: 0;
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.32));
    transform: rotate(2deg);
    pointer-events: none;
  }

  .mc-problem__record::before,
  .mc-problem__record::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(248, 246, 239, 0.94);
    box-shadow: 0 20px 42px rgba(0, 0, 0, 0.28);
  }

  .mc-problem__record::before {
    transform: translate3d(-18px, 12px, 0) rotate(-1.5deg);
  }

  .mc-problem__record::after {
    transform: translate3d(-9px, 6px, 0) rotate(-0.8deg);
  }

  .mc-problem__record img {
    display: block;
    width: 100%;
    height: auto;
  }

  .mc-solution,
  .mc-focus,
  .mc-export,
  .mc-faq {
    padding: clamp(5rem, 9vw, 7.5rem) 1.25rem;
    background: #ffffff;
  }

  .mc-solution__stack {
    width: min(56rem, 100%);
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    display: grid;
    gap: 1rem;
  }

  .mc-solution-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    padding: 1.2rem 1.25rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 24px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(246, 249, 253, 0.95)),
      rgba(255, 255, 255, 0.96);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      0 20px 44px rgba(15, 23, 42, 0.08);
  }

  .mc-solution-card img {
    width: 2.4rem;
    height: 2.4rem;
    object-fit: contain;
  }

  .mc-solution-card h3,
  .mc-focus-card h3,
  .mc-phase h3 {
    margin: 0;
    font-size: 1.18rem;
    line-height: 1.14;
    letter-spacing: -0.03em;
    font-weight: 650;
    color: #0f172a;
  }

  .mc-solution-card p,
  .mc-focus-card p {
    margin: 0.45rem 0 0;
    font-size: 1.01rem;
    line-height: 1.5;
    color: rgba(15, 23, 42, 0.68);
  }

  .mc-workflow {
    padding: clamp(5.25rem, 9vw, 7.75rem) 1.25rem;
    background: linear-gradient(180deg, #f7f9fc 0%, #ffffff 100%);
    overflow: clip;
  }

  .mc-workflow__inner {
    width: min(1120px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.75fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .mc-workflow__copy {
    display: grid;
    gap: 1.25rem;
  }

  .mc-workflow__copy h2 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2.8rem, 5vw, 4.1rem);
    line-height: 1;
    letter-spacing: -0.28px;
    font-weight: 700;
  }

  .mc-workflow__copy > p:not(.mc-eyebrow) {
    max-width: 43rem;
    margin: 0;
    font-size: 21px;
    line-height: 1.5;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.65);
  }

  .mc-workflow__phases {
    display: grid;
    gap: 0;
    margin-top: 1.4rem;
    border-top: 1px solid rgba(15, 23, 42, 0.1);
  }

  .mc-phase {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0.5rem 1.25rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid rgba(15, 23, 42, 0.1);
  }

  .mc-phase p {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
    color: #007aff;
  }

  .mc-phase span {
    grid-column: 2;
    font-size: 1rem;
    line-height: 1.5;
    color: rgba(15, 23, 42, 0.64);
  }

  .mc-workflow__phone {
    position: relative;
    width: min(100%, 22rem);
    margin: 0 auto;
    isolation: isolate;
  }

