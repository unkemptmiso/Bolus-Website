---
import { getEntry } from "astro:content";
import defaultPageOgImage from "../assets/hero/ipad-blank.jpg";
import PageTemplate from "../components/content/PageTemplate.astro";
import {
  getStaticSlug,
  secondaryPages,
  siteMetadata,
  type SitePage,
} from "../config/site-manifest";
import BaseLayout from "../layouts/BaseLayout.astro";

export function getStaticPaths() {
  const excludedPaths = new Set(["/about", "/contact", "/pricing", "/paper-anesthesia-chart-alternative", "/mobile-anesthesia-charting"]);
  return secondaryPages
    .filter((page) => !excludedPaths.has(page.path))
    .map((page) => ({
      params: { slug: getStaticSlug(page.path) },
      props: { page },
    }));
}

interface Props {
  page: SitePage;
}

const { page } = Astro.props;
const pageSeo = await getEntry("pages", page.id);
const resolvedSeo = pageSeo?.data ?? {
  title: page.seoTitle,
  description: page.seoDescription,
  canonicalURL: new URL(page.path, siteMetadata.defaultSiteUrl).toString(),
  ogImage: defaultPageOgImage,
  isHomePage: false,
};
---

<BaseLayout page={page} seo={resolvedSeo}>
  <PageTemplate page={page} />
</BaseLayout>
