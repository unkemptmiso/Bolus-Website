---
import { getEntry } from "astro:content";

import { getPageById } from "../config/site-manifest";
import BaseLayout from "../layouts/BaseLayout.astro";

const aboutPage = getPageById("about");
const aboutSeo = await getEntry("pages", "about");

if (!aboutPage) {
  throw new Error("Could not find the 'about' page config.");
}

if (!aboutSeo) {
  throw new Error("Could not find the 'about' page metadata.");
}
---

<BaseLayout
  page={aboutPage}
  seo={aboutSeo.data}
  mainClass="site-main site-main--about"
  footerVariant="dark"
>
  <section class="about-page">
    <section class="about-hero" aria-labelledby="about-title">
      <h1 id="about-title">Why we built Bolus</h1>
      <p class="about-hero__dek">A note from our team</p>
    </section>

    <section class="about-manifesto" aria-label="About Bolus">
      <p>
        We built Bolus because paper charting still creates unnecessary risk in anesthesia practice.
      </p>

      <p>
        Paper records are cumbersome and outdated. They are too easy to misread, misplace, or challenge later.
      </p>

      <p>
        The goal was simple. Create an anesthesia record that is fast to complete, clean to read, and easier to stand behind when it matters.
      </p>

      <p>
        Bolus was built for the real workflow of office-based anesthesia and sedation. It gives clinicians a clearer way to document care without adding friction to the day.
      </p>

      <p>
        We also believe good tools should be accessible. Bolus is intentionally affordable, so providers can modernize their workflow without taking on unnecessary overhead.
      </p>

      <p>
        We hope you enjoy using it. Please reach out to <a href="mailto:contact@bolusanesthesia.com" style="color: #007AFF; font-weight: 600;">contact@bolusanesthesia.com</a> with any suggestions or comments.
      </p>
    </section>
  </section>
</BaseLayout>
