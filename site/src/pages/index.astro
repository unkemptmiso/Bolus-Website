---
import { getImage } from "astro:assets";
import { getEntry } from "astro:content";
import HomeProblemSection from "../components/content/HomeProblemSection.astro";
import HomeExportSection from "../components/content/HomeExportSection.astro";
import HomeFaqSection from "../components/content/HomeFaqSection.astro";
import HomeDownloadSection from "../components/content/HomeDownloadSection.astro";
import HomeSecuritySection from "../components/content/HomeSecuritySection.astro";
import HomeSplashHero from "../components/content/HomeSplashHero.astro";
import HomeSolutionSection from "../components/content/HomeSolutionSection.astro";
import HomeWorkflowSection from "../components/content/HomeWorkflowSection.astro";
import heroDevices from "../assets/hero-devices.png";
import { homePage } from "../config/site-manifest";
import BaseLayout from "../layouts/BaseLayout.astro";

// Optimized metadata from Content Collection (TSOP Enforcement)
const homeSeo = await getEntry("pages", "home");
if (!homeSeo) throw new Error("Could not find the 'home' page metadata.");

const optimizedHeroDevices = await getImage({
  src: heroDevices,
  width: 2560,
  quality: "high",
});

const homepageAssetHints = [
  { href: optimizedHeroDevices.src, as: "image", type: "image/webp", fetchpriority: "high" },
  { href: "/assets/home/crumpled-sample-record.webp", as: "image", type: "image/webp", fetchpriority: "high" },
  { href: "/assets/iphone-17-black-portrait.webp", as: "image", type: "image/webp", fetchpriority: "high" },
  { href: "/assets/workflow/pre-op-evaluation.mp4", as: "video", type: "video/mp4", fetchpriority: "high" },
  { href: "/assets/record-screenshots/page-1.webp", as: "image", type: "image/webp", fetchpriority: "high" },
  { href: "/section3-icons/hourglass-not-done_23f3.png", rel: "prefetch", type: "image/png" },
  { href: "/section3-icons/1f5c2_1f2qe.webp", rel: "prefetch", type: "image/webp" },
  { href: "/section3-icons/1f4e4_1knv5.webp", rel: "prefetch", type: "image/webp" },
  { href: "/assets/record-screenshots/page-2.webp", rel: "prefetch", type: "image/webp" },
  { href: "/assets/record-screenshots/page-3.webp", rel: "prefetch", type: "image/webp" },
  { href: "/assets/record-screenshots/page-4.webp", rel: "prefetch", type: "image/webp" },
  { href: "/assets/record-screenshots/page-5.webp", rel: "prefetch", type: "image/webp" },
  { href: "/assets/record-screenshots/page-6.webp", rel: "prefetch", type: "image/webp" },
  { href: "/assets/workflow/pre-op-consent.mp4", rel: "prefetch", type: "video/mp4" },
  { href: "/assets/workflow/pre-op-media-attachment.mp4", rel: "prefetch", type: "video/mp4" },
  { href: "/assets/workflow/intra-op-vitals.mp4", rel: "prefetch", type: "video/mp4" },
  { href: "/assets/workflow/intra-op-medications.mp4", rel: "prefetch", type: "video/mp4" },
  { href: "/assets/workflow/intra-op-events.mp4", rel: "prefetch", type: "video/mp4" },
  { href: "/assets/workflow/post-op-vitals.mp4", rel: "prefetch", type: "video/mp4" },
  { href: "/assets/workflow/post-op-substances.mp4", rel: "prefetch", type: "video/mp4" },
] as const;
---

<BaseLayout
  page={homePage}
  seo={homeSeo.data}
  showChrome={false}
  showHeader={true}
  showFooter={true}
  footerOmitGroups={["compare"]}
  mainClass="site-main site-main--splash"
  assetHints={homepageAssetHints}
>
  <HomeSplashHero />
  <HomeProblemSection />
  <HomeSolutionSection />
  <HomeWorkflowSection />
  <HomeExportSection />
  <HomeSecuritySection />
  <HomeFaqSection />
  <HomeDownloadSection />
</BaseLayout>
