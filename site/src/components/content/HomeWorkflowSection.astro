---
const workflowPreviewClips = {
  "pre-op": [
    {
      id: "evaluation",
      src: "/assets/workflow/pre-op-evaluation.mp4",
    },
    {
      id: "consent",
      src: "/assets/workflow/pre-op-consent.mp4",
    },
    {
      id: "media",
      src: "/assets/workflow/pre-op-media-attachment.mp4",
    },
  ],
  "intra-op": [
    {
      id: "vitals",
      src: "/assets/workflow/intra-op-vitals.mp4",
    },
    {
      id: "medications",
      src: "/assets/workflow/intra-op-medications.mp4",
    },
    {
      id: "events",
      src: "/assets/workflow/intra-op-events.mp4",
    },
  ],
  "post-op": [
    {
      id: "vitals",
      src: "/assets/workflow/post-op-vitals.mp4",
    },
    {
      id: "substances",
      src: "/assets/workflow/post-op-substances.mp4",
    },
  ],
} as const;

const workflowPhases = [
  {
    id: "pre-op",
    label: "Pre-Op",
    heading: "Pre-Op without the paper shuffle.",
    body: "Bolus helps you move through Pre-Op quickly by keeping the essential documentation in one place from the start.",
    points: [
      {
        title: "Built-in evaluation notes",
        body: "Pre-Op evaluation notes are already part of the workflow, so you can document them quickly without separate forms or extra steps.",
      },
      {
        title: "Consent captured in the record",
        body: "Consent forms are attached and signed electronically to the case record automatically.",
      },
      {
        title: "Media added on the spot",
        body: "Use the camera or attachments to add supporting images and files directly to the record.",
      },
    ],
  },
  {
    id: "intra-op",
    label: "Intra-Op",
    heading: "Intra-Op charting that keeps up.",
    body: "With a timeline that continues to move through the case, Bolus helps you chart quickly without constantly feeling like you have to catch up.",
    points: [
      {
        title: "Vitals in seconds, one hand, no manual entry",
        body: "Chart vital signs in seconds with one hand, no more manually entering numbers one at a time.",
      },
      {
        title: "One-tap medications",
        body: "Chart common medications, infusions, and local anesthetics with a workflow built to keep documentation fast and low-friction during the case.",
      },
      {
        title: "Case events at your fingertips",
        body: "Mark important events and add quick comments as they happen, so the record stays thorough without turning into a distraction.",
      },
    ],
  },
  {
    id: "post-op",
    label: "Post-Op",
    heading: "Post-Op that wraps up cleanly.",
    body: "Bolus makes closing out the record feel quick and organized.",
    points: [
      {
        title: "Fast discharge vitals",
        body: "Enter discharge vitals quickly with a scrubber built for speed.",
      },
      {
        title: "Controlled substance reconciliation",
        body: "Complete reconciliation with a signature pad and totals pulled automatically from the record.",
      },
      {
        title: "One-click secure PDF export",
        body: "Generate a high-fidelity PDF export of the entire anesthesia record instantly.",
      },
    ],
  },
] as const;
---

<section
  class="workflow-section"
  data-workflow-section
  data-workflow-active-phase="pre-op"
  style="--workflow-progress:0; --workflow-phase-index:0; --workflow-copy-shift:0%; --workflow-screen-shift:0%;"
  aria-labelledby="home-workflow-title"
>
  <div class="workflow-section__inner">
    <div class="workflow-section__stage" data-workflow-stage>
      <div class="workflow-section__copy">
        <div class="workflow-section__intro">
          <h2 id="home-workflow-title" class="workflow-section__title">
            <span class="workflow-section__title-line">One workflow from</span>
            <span class="workflow-section__title-line">Pre-Op to Post-Op.</span>
          </h2>
          <p class="workflow-section__lede">Bolus is built to follow the case from start to finish, without sending you back to paper.</p>
        </div>

        <div class="workflow-section__phase-viewport">
          <div class="workflow-section__phase-track" data-workflow-copy-track>
            {workflowPhases.map((phase) => (
              <section class="workflow-phase-card" data-phase={phase.id}>
                <div class="workflow-section__phase">
                  <p class="workflow-section__phase-label">{phase.label}</p>
                  <h3 class="workflow-section__phase-title">{phase.heading}</h3>
                  <p class="workflow-section__phase-body">{phase.body}</p>
                </div>

                <div class="workflow-section__points">
                  {phase.points.map((point, index) => {
                    const workflowClip = workflowPreviewClips[phase.id][index];

                    return (
                      <article
                        class="workflow-point"
                        data-workflow-video-trigger={workflowClip ? "true" : undefined}
                        data-workflow-phase={workflowClip ? phase.id : undefined}
                        data-workflow-clip={workflowClip?.id}
                        tabindex={workflowClip ? "0" : undefined}
                      >
                        <h4>{point.title}</h4>
                        <p>{point.body}</p>
                      </article>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>
        </div>
      </div>

      <div class="workflow-section__device">
        <div class="workflow-phone-shell">
          <div class="workflow-phone" aria-hidden="true">
            <img src="/assets/iphone-17-black-portrait.png" alt="" class="workflow-phone__frame" />

            <div class="workflow-phone__screen-viewport">
              <div class="workflow-phone__screen-track" data-workflow-screen-track>
                {workflowPhases.map((phase) => {
                  const phaseClips = workflowPreviewClips[phase.id];

                  return (
                  <section class={`workflow-phone__screen workflow-phone__screen--${phase.id}`}>
                    {phaseClips.length > 0 && (
                      <div
                        class="workflow-phone__preview"
                        data-workflow-video-container
                        data-workflow-video-phase={phase.id}
                        data-workflow-media-state="video"
                      >
                        <div class="workflow-phone__preview-media">
                          {phaseClips.map((clip, index) => (
                            <video
                              class={`workflow-phone__preview-video${index === 0 ? " is-active" : ""}`}
                              data-workflow-video
                              data-workflow-video-phase={phase.id}
                              data-workflow-clip-id={clip.id}
                              src={clip.src}
                              muted
                              autoplay={phase.id === "pre-op" && index === 0 ? true : undefined}
                              playsinline
                              preload={phase.id === "pre-op" && index === 0 ? "auto" : "metadata"}
                              aria-hidden="true"
                            ></video>
                          ))}
                        </div>
                      </div>
                    )}
                  </section>
                  );
                })}
              </div>
            </div>
          </div>

          <nav class="workflow-tabs" data-workflow-tabs aria-label="Workflow phases">
            <div class="workflow-tabs__list">
              {workflowPhases.map((phase, index) => (
                <button
                  type="button"
                  class={`workflow-tabs__item${index === 0 ? " is-active" : ""}`}
                  data-phase-trigger
                  data-phase={phase.id}
                  aria-current={index === 0 ? "page" : undefined}
                >
                  <span>{phase.label}</span>
                </button>
              ))}
            </div>
          </nav>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.querySelector("[data-workflow-section]");
    if (!(section instanceof HTMLElement)) return;

    const tabs = Array.from(section.querySelectorAll("[data-phase-trigger]"));
    if (!tabs.length) return;
    const clipTriggers = Array.from(section.querySelectorAll("[data-workflow-video-trigger]"));
    const videoSlots = Array.from(section.querySelectorAll("[data-workflow-video]"));

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const compactLayout = window.matchMedia("(max-width: 820px)");
    const phaseIds = ["pre-op", "intra-op", "post-op"];
    const phaseProgressMap = [0, 0.4, 0.8];
    const workflowCrossfadeMs = 760;
    const workflowClips = {
      "pre-op": [
        { id: "evaluation", src: "/assets/workflow/pre-op-evaluation.mp4" },
        { id: "consent", src: "/assets/workflow/pre-op-consent.mp4" },
        { id: "media", src: "/assets/workflow/pre-op-media-attachment.mp4" },
      ],
      "intra-op": [
        { id: "vitals", src: "/assets/workflow/intra-op-vitals.mp4" },
        { id: "medications", src: "/assets/workflow/intra-op-medications.mp4" },
        { id: "events", src: "/assets/workflow/intra-op-events.mp4" },
      ],
      "post-op": [
        { id: "vitals", src: "/assets/workflow/post-op-vitals.mp4" },
        { id: "substances", src: "/assets/workflow/post-op-substances.mp4" },
      ],
    };
    let rafId = 0;
    let latestProgress = 0;
    let lockedPhaseIndex = null;
    let lockExpiresAt = 0;
    let activeClipIndexByPhase = {
      "pre-op": 0,
      "intra-op": 0,
      "post-op": 0,
    };
    let requestedClipIndexByPhase = {
      "pre-op": 0,
      "intra-op": 0,
      "post-op": 0,
    };

    const getPhaseClips = (phase) => workflowClips[phase] ?? [];

    const getPhaseVideoSlots = (phase) =>
      videoSlots.filter((video) => video.dataset.workflowVideoPhase === phase);

    const getVideoSlot = (phase, clipIndex) => {
      const clip = getPhaseClips(phase)[clipIndex];
      if (!clip) return null;

      const slot = videoSlots.find(
        (video) =>
          video.dataset.workflowVideoPhase === phase && video.dataset.workflowClipId === clip.id,
      );
      return slot instanceof HTMLVideoElement ? slot : null;
    };

    const prepareVideoSlot = (slot) => {
      slot.muted = true;
      slot.defaultMuted = true;
      slot.playsInline = true;
      slot.preload = "auto";
    };

    const pauseWorkflowPreview = (phase) => {
      getPhaseVideoSlots(phase).forEach((slot) => {
        if (!(slot instanceof HTMLVideoElement)) return;

        slot.pause();
      });
    };

    const playSlot = (slot, { restart = false } = {}) => {
      prepareVideoSlot(slot);

      if (restart) {
        slot.currentTime = 0;
      }

      const playback = slot.play();
      if (playback && typeof playback.catch === "function") {
        playback.catch(() => {});
      }
    };

    const warmWorkflowVideos = () => {
      videoSlots.forEach((slot) => {
        if (!(slot instanceof HTMLVideoElement)) return;

        prepareVideoSlot(slot);

        if (slot.readyState === HTMLMediaElement.HAVE_NOTHING) {
          slot.load();
        }
      });
    };

    const whenVideoCanRender = (slot, callback) => {
      if (slot.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
        callback();
        return;
      }

      let settled = false;
      const finish = () => {
        if (settled) return;
        settled = true;
        slot.removeEventListener("loadeddata", finish);
        slot.removeEventListener("canplay", finish);
        callback();
      };

      slot.addEventListener("loadeddata", finish);
      slot.addEventListener("canplay", finish);
      prepareVideoSlot(slot);
      slot.load();
    };

    const crossFadeToClip = (phase, clipIndex, { restart = true } = {}) => {
      const clip = getPhaseClips(phase)[clipIndex];
      const nextSlot = getVideoSlot(phase, clipIndex);
      if (!clip || !nextSlot) return;

      requestedClipIndexByPhase[phase] = clipIndex;

      whenVideoCanRender(nextSlot, () => {
        if (requestedClipIndexByPhase[phase] !== clipIndex) return;

        const phaseSlots = getPhaseVideoSlots(phase);
        const currentSlots = phaseSlots.filter((slot) => slot.classList.contains("is-active"));

        activeClipIndexByPhase[phase] = clipIndex;
        playSlot(nextSlot, { restart });
        nextSlot.classList.add("is-active");

        currentSlots.forEach((slot) => {
          if (slot !== nextSlot) {
            slot.classList.add("is-leaving");
            slot.classList.remove("is-active");
          }
        });

        window.setTimeout(() => {
          phaseSlots.forEach((slot) => {
            if (slot instanceof HTMLVideoElement && slot !== nextSlot) {
              slot.classList.remove("is-leaving");
              slot.pause();
            }
          });
        }, workflowCrossfadeMs + 80);
      });
    };

    const playClipByIndex = (phase, clipIndex, options = {}) => {
      const activeSlot = getVideoSlot(phase, activeClipIndexByPhase[phase] ?? 0);
      const clip = getPhaseClips(phase)[clipIndex];
      if (!activeSlot || !clip) return;

      if (activeClipIndexByPhase[phase] === clipIndex) {
        playSlot(activeSlot, options);
        return;
      }

      crossFadeToClip(phase, clipIndex, options);
    };

    const playNextWorkflowClip = (phase) => {
      const phaseClips = getPhaseClips(phase);
      if (!phaseClips.length) return;

      playClipByIndex(phase, ((activeClipIndexByPhase[phase] ?? 0) + 1) % phaseClips.length);
    };

    const pauseInactiveWorkflowPreviews = (activePhase) => {
      phaseIds.forEach((phase) => {
        if (phase !== activePhase) {
          pauseWorkflowPreview(phase);
        }
      });
    };

    const setActiveTab = (activeIndex) => {
      tabs.forEach((tab, index) => {
        const isActive = index === activeIndex;
        tab.classList.toggle("is-active", isActive);

        if (isActive) {
          tab.setAttribute("aria-current", "page");
        } else {
          tab.removeAttribute("aria-current");
        }
      });
    };

    const getPhaseIndex = (progress) => {
      if (progress < 0.28) return 0;
      if (progress < 0.58) return 1;
      return 2;
    };

    const isPhaseAligned = (phaseIndex, progress) => {
      if (phaseIndex === 0) return progress < 0.28;
      if (phaseIndex === 1) return progress >= 0.28 && progress < 0.58;
      return progress >= 0.58;
    };

    const applyPhase = (activeIndex, progress) => {
      const shift = `${activeIndex * 100}%`;
      const activePhase = phaseIds[activeIndex];

      section.style.setProperty("--workflow-progress", progress.toFixed(4));
      section.style.setProperty("--workflow-phase-index", `${activeIndex}`);
      section.style.setProperty("--workflow-copy-shift", shift);
      section.style.setProperty("--workflow-screen-shift", shift);
      section.dataset.workflowActivePhase = activePhase;

      if (getPhaseClips(activePhase).length) {
        playClipByIndex(activePhase, activeClipIndexByPhase[activePhase] ?? 0, { restart: false });
      }
      pauseInactiveWorkflowPreviews(activePhase);

      setActiveTab(activeIndex);
    };

    const flushPhase = () => {
      rafId = 0;

      if (
        lockedPhaseIndex !== null &&
        (isPhaseAligned(lockedPhaseIndex, latestProgress) || performance.now() > lockExpiresAt)
      ) {
        lockedPhaseIndex = null;
      }

      const activeIndex = lockedPhaseIndex ?? getPhaseIndex(latestProgress);
      const displayProgress =
        lockedPhaseIndex === null ? latestProgress : phaseProgressMap[activeIndex];

      applyPhase(activeIndex, displayProgress);
    };

    const resetStatic = () => {
      latestProgress = 0;
      lockedPhaseIndex = null;
      applyPhase(0, 0);
    };

    const updateTarget = () => {
      if (reducedMotion.matches || compactLayout.matches) {
        resetStatic();
        return;
      }

      const rect = section.getBoundingClientRect();
      const scrollSpan = Math.max(section.offsetHeight - window.innerHeight, 1);
      const traveled = Math.min(Math.max(-rect.top, 0), scrollSpan);

      latestProgress = traveled / scrollSpan;

      if (!rafId) {
        rafId = window.requestAnimationFrame(flushPhase);
      }
    };

    const handleChange = () => {
      if (rafId) {
        window.cancelAnimationFrame(rafId);
        rafId = 0;
      }
      updateTarget();
    };

    const scrollToPhase = (phaseIndex) => {
      const rect = section.getBoundingClientRect();
      const sectionTop = window.scrollY + rect.top;
      const scrollSpan = Math.max(section.offsetHeight - window.innerHeight, 1);
      const targetTop = sectionTop + scrollSpan * phaseProgressMap[phaseIndex];

      if (reducedMotion.matches) {
        window.scrollTo({
          top: targetTop,
          behavior: "auto",
        });
        return;
      }

      window.scrollTo({
        top: targetTop,
        behavior: "smooth",
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        latestProgress = phaseProgressMap[index];
        lockedPhaseIndex = index;
        lockExpiresAt = performance.now() + 1400;

        applyPhase(index, latestProgress);

        if (!compactLayout.matches) {
          scrollToPhase(index);
        }
      });
    });

    videoSlots.forEach((slot) => {
      if (!(slot instanceof HTMLVideoElement)) return;

      slot.addEventListener("ended", () => {
        if (slot.classList.contains("is-active")) {
          const phase = slot.dataset.workflowVideoPhase;
          if (phase) {
            playNextWorkflowClip(phase);
          }
        }
      });
    });

    clipTriggers.forEach((trigger) => {
      if (!(trigger instanceof HTMLElement)) return;

      const cueClip = () => {
        const phase = trigger.dataset.workflowPhase;
        const phaseClips = getPhaseClips(phase);
        const clipIndex = phaseClips.findIndex((clip) => clip.id === trigger.dataset.workflowClip);
        if (clipIndex >= 0) {
          playClipByIndex(phase, clipIndex);
        }
      };

      trigger.addEventListener("pointerenter", cueClip);
      trigger.addEventListener("focus", cueClip);
    });

    window.addEventListener("scroll", updateTarget, { passive: true });
    window.addEventListener("resize", handleChange);
    reducedMotion.addEventListener?.("change", handleChange);
    compactLayout.addEventListener?.("change", handleChange);

    updateTarget();
    playClipByIndex("pre-op", 0, { restart: false });

    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(warmWorkflowVideos, { timeout: 1200 });
    } else {
      window.setTimeout(warmWorkflowVideos, 600);
    }
  })();
</script>
