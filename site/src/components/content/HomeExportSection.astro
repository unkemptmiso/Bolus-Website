---
const recordPages = [
  {
    src: "/assets/record-screenshots/page-1.webp",
    label: "Record page 1",
  },
  {
    src: "/assets/record-screenshots/page-2.webp",
    label: "Record page 2",
  },
  {
    src: "/assets/record-screenshots/page-3.webp",
    label: "Record page 3",
  },
  {
    src: "/assets/record-screenshots/page-4.webp",
    label: "Record page 4",
  },
  {
    src: "/assets/record-screenshots/page-5.webp",
    label: "Record page 5",
  },
  {
    src: "/assets/record-screenshots/page-6.webp",
    label: "Record page 6",
  },
] as const;

const initialSpread = 190;
const focusStage = 520;
const initialYaw = -20;
---

<section class="export-section" aria-labelledby="home-export-title">
  <div class="export-section__inner">
    <div class="export-section__copy">
      <h2 id="home-export-title" class="export-section__title">
        An anesthesia record that doesn’t look like it’s from the 90s.
      </h2>
      <p class="export-section__body">
        The final record is clean, legible, and thoughtfully structured, with medications, vital
        signs, and intraoperative events laid out clearly to reduce ambiguity and reflect the
        quality of care delivered.
      </p>
    </div>

    <div class="export-section__preview">
      <div
        class="record-rolodex"
        data-record-rolodex
        data-active-index="0"
        style={`--active-index:0;--page-count:${recordPages.length};`}
      >
        {recordPages.map((page, index) => {
          const shift = index * initialSpread;
          const depth = index === 0 ? 48 : index * -14;
          const scale = index === 0 ? 1.04 : Math.max(0.84, 0.94 - index * 0.015);
          const zIndex = 60 - index;

          return (
            <button
              class:list={["export-document-card", { "is-active": index === 0 }]}
              type="button"
              data-record-page
              data-page-index={index}
              aria-pressed={index === 0 ? "true" : "false"}
              aria-label={`Preview ${page.label}`}
              style={`--page-shift:${shift}px;--page-depth:${depth}px;--page-yaw:${initialYaw}deg;--page-scale:${scale};--page-z:${zIndex};`}
            >
              <img
                src={page.src}
                alt={page.label}
                width="2479"
                height="3508"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
              />
            </button>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const mobileCarouselBreakpoint = "(max-width: 768px)";
    const rolodexes = document.querySelectorAll("[data-record-rolodex]");
    const mobileCarousel = window.matchMedia(mobileCarouselBreakpoint);
    const getGeometry = () => {
      if (window.matchMedia(mobileCarouselBreakpoint).matches) {
        return { restSpread: 64, neighborNudge: 28 };
      }

      if (window.matchMedia("(max-width: 720px)").matches) {
        return { restSpread: 82, neighborNudge: 40 };
      }

      if (window.matchMedia("(max-width: 980px)").matches) {
        return { restSpread: 88, neighborNudge: 34 };
      }

      if (window.matchMedia("(max-width: 1180px)").matches) {
        return { restSpread: 132, neighborNudge: 50 };
      }

      return { restSpread: 190, neighborNudge: 72 };
    };

    rolodexes.forEach((rolodex) => {
      const pages = Array.from(rolodex.querySelectorAll("[data-record-page]"));

      if (!(rolodex instanceof HTMLElement) || pages.length === 0) {
        return;
      }

      let mobileProgrammaticScroll = false;
      let mobileProgrammaticScrollTimer = 0;

      const getDesktopLayout = () => {
        const { restSpread, neighborNudge } = getGeometry();
        const firstPage = pages[0];

        if (!(firstPage instanceof HTMLElement)) {
          return {
            restSpread,
            neighborNudge,
            minShift: 0,
            maxShift: restSpread * Math.max(0, pages.length - 1),
          };
        }

        const pageBounds = firstPage.getBoundingClientRect();
        const rolodexBounds = rolodex.getBoundingClientRect();
        const pageWidth = pageBounds.width || firstPage.offsetWidth;
        const rolodexWidth = rolodexBounds.width || rolodex.clientWidth;
        const computedLeft = Number.parseFloat(window.getComputedStyle(firstPage).left);
        const pageLeft = Number.isFinite(computedLeft) ? computedLeft : rolodexWidth * 0.18;
        const edgeInset = 28;
        const minShift = Math.max(0, pageWidth / 2 - pageLeft + edgeInset);
        const maxShift = Math.max(minShift, rolodexWidth - pageLeft - pageWidth / 2 - edgeInset);
        const pageIntervals = Math.max(1, pages.length - 1);
        const availableSpread = Math.max(48, (maxShift - minShift) / pageIntervals);
        const safeSpread = Math.min(restSpread, availableSpread);
        const previousPagePeek = Math.min(76, Math.max(44, safeSpread * 0.72));

        return {
          restSpread: safeSpread,
          neighborNudge: Math.min(neighborNudge, Math.max(18, safeSpread * 0.45)),
          previousPagePeek,
          minShift,
          maxShift,
        };
      };

      const clampPageShift = (shift, layout) => Math.min(layout.maxShift, Math.max(layout.minShift, shift));

      const updateActiveState = (activeIndex) => {
        rolodex.dataset.activeIndex = String(activeIndex);
        rolodex.style.setProperty("--active-index", String(activeIndex));

        pages.forEach((page, index) => {
          if (!(page instanceof HTMLElement)) return;

          const isActive = index === activeIndex;
          page.classList.toggle("is-active", isActive);
          page.setAttribute("aria-pressed", isActive ? "true" : "false");
          page.style.setProperty("--page-z", isActive ? "90" : String(60 - index));
        });
      };

      const syncMobileActivePage = () => {
        if (!mobileCarousel.matches) return;
        if (mobileProgrammaticScroll) return;

        const viewportCenter = rolodex.scrollLeft + rolodex.clientWidth / 2;
        const activeIndex = pages.reduce((closestIndex, page, index) => {
          if (!(page instanceof HTMLElement)) return closestIndex;

          const closestPage = pages[closestIndex];
          if (!(closestPage instanceof HTMLElement)) return index;

          const pageCenter = page.offsetLeft + page.offsetWidth / 2;
          const closestCenter = closestPage.offsetLeft + closestPage.offsetWidth / 2;

          return Math.abs(pageCenter - viewportCenter) < Math.abs(closestCenter - viewportCenter)
            ? index
            : closestIndex;
        }, 0);

        updateActiveState(activeIndex);
      };

      const finishMobileProgrammaticScroll = () => {
        mobileProgrammaticScroll = false;
        window.clearTimeout(mobileProgrammaticScrollTimer);
        mobileProgrammaticScrollTimer = 0;
        syncMobileActivePage();
      };

      const stopMobileProgrammaticScroll = () => {
        if (!mobileProgrammaticScroll) return;

        mobileProgrammaticScroll = false;
        window.clearTimeout(mobileProgrammaticScrollTimer);
        mobileProgrammaticScrollTimer = 0;
      };

      const centerMobilePage = (index) => {
        if (!mobileCarousel.matches) return false;

        const page = pages[index];
        if (!(page instanceof HTMLElement)) return false;

        const targetScrollLeft = page.offsetLeft - (rolodex.clientWidth - page.offsetWidth) / 2;
        mobileProgrammaticScroll = true;
        updateActiveState(index);
        window.clearTimeout(mobileProgrammaticScrollTimer);
        rolodex.scrollTo({ left: targetScrollLeft, behavior: "smooth" });
        mobileProgrammaticScrollTimer = window.setTimeout(finishMobileProgrammaticScroll, 720);

        return true;
      };

      let mobileScrollFrame = 0;
      const queueMobileActivePageSync = () => {
        if (mobileScrollFrame !== 0) return;

        mobileScrollFrame = window.requestAnimationFrame(() => {
          mobileScrollFrame = 0;
          syncMobileActivePage();
        });
      };

      const setRestingStack = () => {
        if (mobileCarousel.matches) {
          syncMobileActivePage();
          return;
        }

        const layout = getDesktopLayout();
        updateActiveState(0);

        pages.forEach((page, index) => {
          if (!(page instanceof HTMLElement)) return;

          const isActive = index === 0;
          const shift = clampPageShift(index * layout.restSpread, layout);

          page.style.setProperty("--page-shift", `${shift}px`);
          page.style.setProperty("--page-depth", isActive ? "48px" : `${index * -14}px`);
          page.style.setProperty("--page-yaw", isActive ? "-18deg" : "-20deg");
          page.style.setProperty("--page-scale", isActive ? "1.04" : String(Math.max(0.84, 0.94 - index * 0.015)));
        });
      };

      const setActivePage = (activeIndex) => {
        if (mobileCarousel.matches) {
          updateActiveState(activeIndex);
          return;
        }

        const layout = getDesktopLayout();
        const { restSpread, neighborNudge } = layout;
        const activeShift = clampPageShift(
          Math.max(activeIndex * restSpread, layout.minShift + layout.previousPagePeek),
          layout,
        );
        updateActiveState(activeIndex);

        pages.forEach((page, index) => {
          if (!(page instanceof HTMLElement)) return;

          const isActive = index === activeIndex;

          /* Active card stays at its natural position; 
             neighbors shift slightly away to make room */
          let shift;
          if (isActive) {
            shift = activeShift;
          } else if (index === activeIndex - 1) {
            shift = activeShift - layout.previousPagePeek;
          } else if (index < activeIndex) {
            shift = index * restSpread - neighborNudge;
          } else {
            shift = index * restSpread + neighborNudge;
          }

          shift = clampPageShift(shift, layout);

          page.style.setProperty("--page-shift", `${shift}px`);
          page.style.setProperty("--page-depth", isActive ? "68px" : `${index * -14}px`);
          page.style.setProperty("--page-yaw", isActive ? "0deg" : "-20deg");
          page.style.setProperty("--page-scale", isActive ? "1.06" : String(Math.max(0.84, 0.94 - index * 0.015)));
        });
      };

      const focusPage = (index) => {
        if (mobileCarousel.matches) {
          updateActiveState(index);
          return;
        }

        setActivePage(index);
      };

      pages.forEach((page, index) => {
        page.addEventListener("mouseenter", () => setActivePage(index));
        page.addEventListener("focus", () => focusPage(index));
        page.addEventListener("click", (event) => {
          if (centerMobilePage(index)) {
            event.preventDefault();
          }
        });
      });

      rolodex.addEventListener("mouseleave", setRestingStack);
      rolodex.addEventListener("scroll", queueMobileActivePageSync, { passive: true });
      rolodex.addEventListener("pointerdown", stopMobileProgrammaticScroll, { passive: true });
      rolodex.addEventListener("scrollend", finishMobileProgrammaticScroll);
      window.addEventListener("resize", () => {
        if (mobileCarousel.matches) {
          syncMobileActivePage();
          return;
        }

        const activeIndex = Number(rolodex.dataset.activeIndex ?? 0);
        if (Number.isNaN(activeIndex) || activeIndex === 0) {
          setRestingStack();
          return;
        }

        setActivePage(activeIndex);
      });
      mobileCarousel.addEventListener?.("change", () => window.requestAnimationFrame(setRestingStack));

      setRestingStack();
    });
  })();
</script>
